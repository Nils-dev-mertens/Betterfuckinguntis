{
  "expo": {
    "name": "Actually Usable Calendar",
    "slug": "actually-usable-calendar",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "actuallyusablecalendar",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.actuallyusablecalendar.app"
    },
    "android": {
      "package": "com.actuallyusablecalendar.app",
      "adaptiveIcon": {
        "backgroundColor": "#111116",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 10200
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "splash": {
      "backgroundColor": "#111116"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/actually-usable-calendar"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111116",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#7C5CFF",
          "mode": "production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c39a97ae-7428-4071-b781-0dbdb40e7915"
      }
    }
  }
}
